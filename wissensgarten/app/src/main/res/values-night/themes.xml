<resources>
    <style name="Theme.Wissensgarten" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <!-- Startbild (Android-12-Splash-API, auch auf älteren Geräten): App-Farbe + Logo, kein weißes Aufblitzen -->
    <style name="Theme.Wissensgarten.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Wissensgarten</item>
    </style>
    <color name="window_bg">#15190F</color>
</resources>
