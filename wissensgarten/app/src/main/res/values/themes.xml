<resources>
    <style name="Theme.Wissensgarten" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <!-- Startbild (Android-12-Splash-API, auch auf älteren Geräten): App-Farbe + Logo, kein weißes Aufblitzen -->
    <style name="Theme.Wissensgarten.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Wissensgarten</item>
    </style>
    <color name="cream">#FBF6EC</color>
    <color name="window_bg">#FBF6EC</color>
    <color name="moss">#3F6B3A</color>
    <color name="leaf">#6FA35A</color>
    <color name="soil">#7A5232</color>
</resources>
