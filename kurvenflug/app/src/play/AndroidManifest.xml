<?xml version="1.0" encoding="utf-8"?>
<!-- Play-Variante: kein Internet, keine Installations-Berechtigung. Zwei Rechte der Widget-Bibliothek (WorkManager)
     braucht Kurvenflug nicht – raus damit, damit die Play Console keine Vordergrund-Dienst-Erklärung verlangt. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <!-- Die Billing-Bibliothek bringt INTERNET mit. Der Kauf selbst läuft über die Play-Store-App (Verbindung zwischen
         den Apps auf dem Gerät), Kurvenflug braucht kein Internet. Vor jeder Freigabe: Testkauf im internen Test. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
</manifest>
