    {
      "img": "🦁🐒🦒",
      "text": "Wörter sind wie Tiere im Zoo: Es gibt verschiedene Arten! Drei davon lernst du heute kennen."
    },
    {
      "img": "🐕🏷️",
      "text": "Nomen sind Namenwörter – wie ein Namensschild 🏷️: Hund, Schule, Freude. Man schreibt sie groß, davor passt der, die oder das."
    },
    {
      "img": "🤸🏃",
      "text": "Verben sind Tuwörter – der Läufer 🏃 zeigt: hier tut jemand was! Springen, lesen, singen. Test: „wir springen“ – passt!"
    },
    {
      "img": "🌈🎨",
      "text": "Adjektive sind Wiewörter – der Malkasten 🎨 zeigt: so sieht etwas aus! Groß, rot, müde. Test: „Der Ball ist rot“ – passt!"
    },
    {
      "img": "💙❤️💚",
      "text": "Die Herzen helfen beim Artikel: 💙 der Mond, ❤️ die Sonne, 💚 das Haus."
    },
    {
      "img": "🌱🎉",
      "text": "Los geht's! Jede richtige Antwort lässt eine Pflanze wachsen!"
    }
  ],
